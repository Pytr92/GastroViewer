<?xml version='1.0' encoding="UTF-8" ?>
<schema
   targetNamespace="http://mapserver.gis.umn.edu/mapserver" 
   xmlns:ms="http://mapserver.gis.umn.edu/mapserver" 
   xmlns:xsd="http://www.w3.org/2001/XMLSchema"
   xmlns="http://www.w3.org/2001/XMLSchema"
   xmlns:gml="http://www.opengis.net/gml/3.2"
   elementFormDefault="qualified" version="0.1" >

  <import namespace="http://www.opengis.net/gml/3.2"
          schemaLocation="http://www.wfs.nrw.de/schemas/gml/3.2.1/gml.xsd" />

  <element name="Zaehlstellen" 
           type="ms:ZaehlstellenType" 
           substitutionGroup="gml:AbstractFeature" />

  <complexType name="ZaehlstellenType">
    <complexContent>
      <extension base="gml:AbstractFeatureType">
        <sequence>
          <element name="Shape" type="gml:PointPropertyType" minOccurs="0" maxOccurs="1"/>
          <element name="ABS" minOccurs="0" type="string"/>
          <element name="STAT" minOccurs="0" type="string"/>
          <element name="ZSTNR" minOccurs="0" type="string"/>
          <element name="ZSTART" minOccurs="0" type="string"/>
          <element name="ZSTARTKNZ" minOccurs="0" type="string"/>
          <element name="ERFASSART" minOccurs="0" type="string"/>
          <element name="BZUSTAND" minOccurs="0" type="string"/>
          <element name="NETZSTAND" minOccurs="0" type="string"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>

</schema>
